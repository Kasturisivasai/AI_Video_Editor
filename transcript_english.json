{
  "language": "tel",
  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 2.0,
      "text": "I recently handled a case"
    },
    {
      "id": 2,
      "start": 2.0,
      "end": 4.2,
      "text": "about toxic managers and employees."
    },
    {
      "id": 3,
      "start": 4.2,
      "end": 5.8,
      "text": "Let me share it now."
    },
    {
      "id": 4,
      "start": 5.8,
      "end": 8.0,
      "text": "I am Dr. Hema Prasad, psychologist."
    },
    {
      "id": 5,
      "start": 9.8,
      "end": 12.2,
      "text": "A young guy I know,"
    },
    {
      "id": 6,
      "start": 12.2,
      "end": 14.5,
      "text": "who is very smart,"
    },
    {
      "id": 7,
      "start": 14.5,
      "end": 16.5,
      "text": "landed an MNC job"
    },
    {
      "id": 8,
      "start": 16.5,
      "end": 19.0,
      "text": "at a very young age."
    },
    {
      "id": 9,
      "start": 19.0,
      "end": 21.0,
      "text": "While working there,"
    },
    {
      "id": 10,
      "start": 21.0,
      "end": 24.5,
      "text": "his colleagues were much older."
    },
    {
      "id": 11,
      "start": 24.5,
      "end": 27.5,
      "text": "They saw his good performance"
    },
    {
      "id": 12,
      "start": 27.5,
      "end": 30.5,
      "text": "and his regular salary hikes."
    },
    {
      "id": 13,
      "start": 30.5,
      "end": 33.5,
      "text": "Compared to them,"
    },
    {
      "id": 14,
      "start": 33.5,
      "end": 36.5,
      "text": "he earned twice as much."
    },
    {
      "id": 15,
      "start": 36.5,
      "end": 39.5,
      "text": "So they felt jealous"
    },
    {
      "id": 16,
      "start": 39.5,
      "end": 43.0,
      "text": "and constantly criticized him."
    },
    {
      "id": 17,
      "start": 43.0,
      "end": 46.5,
      "text": "Because of that, he faced"
    },
    {
      "id": 18,
      "start": 46.5,
      "end": 49.5,
      "text": "vulgar language and abuse."
    },
    {
      "id": 19,
      "start": 49.5,
      "end": 53.0,
      "text": "They treated him terribly,"
    },
    {
      "id": 20,
      "start": 53.0,
      "end": 55.5,
      "text": "pushing him into depression."
    },
    {
      "id": 21,
      "start": 55.5,
      "end": 58.5,
      "text": "Later, he came to me."
    },
    {
      "id": 22,
      "start": 58.5,
      "end": 102.0,
      "text": "When I analyzed the situation,"
    },
    {
      "id": 23,
      "start": 102.0,
      "end": 105.5,
      "text": "it was his environment."
    },
    {
      "id": 24,
      "start": 105.5,
      "end": 108.5,
      "text": "He just wanted to work happily."
    },
    {
      "id": 25,
      "start": 108.5,
      "end": 112.0,
      "text": "He was a knowledgeable person"
    },
    {
      "id": 26,
      "start": 112.0,
      "end": 115.5,
      "text": "who got along with everyone."
    },
    {
      "id": 27,
      "start": 115.5,
      "end": 119.0,
      "text": "Their plot to kick him out"
    },
    {
      "id": 28,
      "start": 119.0,
      "end": 122.5,
      "text": "and their toxic mindset"
    },
    {
      "id": 29,
      "start": 122.5,
      "end": 126.5,
      "text": "deeply impacted his life."
    }
  ]
}