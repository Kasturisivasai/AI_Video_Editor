{
  "language": "te",
  "segments": [
    {
      "id": 1,
      "start": 0.08,
      "end": 2.4,
      "text": "I recently handled a case"
    },
    {
      "id": 2,
      "start": 2.4,
      "end": 4.54,
      "text": "about toxic managers and employees."
    },
    {
      "id": 3,
      "start": 4.54,
      "end": 6.0,
      "text": "I'll tell you about it."
    },
    {
      "id": 4,
      "start": 6.0,
      "end": 8.52,
      "text": "I am Dr. Hyma Prasad, Psychologist."
    },
    {
      "id": 5,
      "start": 9.92,
      "end": 12.16,
      "text": "A boy I know,"
    },
    {
      "id": 6,
      "start": 12.16,
      "end": 14.88,
      "text": "very smart at a young age,"
    },
    {
      "id": 7,
      "start": 14.88,
      "end": 17.58,
      "text": "landed a great MNC job."
    },
    {
      "id": 8,
      "start": 18.24,
      "end": 21.0,
      "text": "While working his job,"
    },
    {
      "id": 9,
      "start": 21.0,
      "end": 23.96,
      "text": "the people around him"
    },
    {
      "id": 10,
      "start": 23.96,
      "end": 26.78,
      "text": "were quite senior in age."
    },
    {
      "id": 11,
      "start": 26.78,
      "end": 29.5,
      "text": "As he performed well"
    },
    {
      "id": 12,
      "start": 29.5,
      "end": 32.72,
      "text": "and continued his work,"
    },
    {
      "id": 13,
      "start": 32.72,
      "end": 35.74,
      "text": "his salary kept getting hiked."
    },
    {
      "id": 14,
      "start": 35.8,
      "end": 37.94,
      "text": "Compared to them,"
    },
    {
      "id": 15,
      "start": 37.94,
      "end": 40.5,
      "text": "he earned twice as much."
    },
    {
      "id": 16,
      "start": 40.5,
      "end": 42.18,
      "text": "They grew jealous of him"
    },
    {
      "id": 17,
      "start": 42.18,
      "end": 44.52,
      "text": "and constantly criticized him."
    },
    {
      "id": 18,
      "start": 44.52,
      "end": 47.46,
      "text": "Right to his face,"
    },
    {
      "id": 19,
      "start": 47.46,
      "end": 50.18,
      "text": "they used vulgar language"
    },
    {
      "id": 20,
      "start": 50.18,
      "end": 52.88,
      "text": "and hurled abuses at him."
    },
    {
      "id": 21,
      "start": 53.04,
      "end": 55.76,
      "text": "Because of this,"
    },
    {
      "id": 22,
      "start": 55.76,
      "end": 58.26,
      "text": "he slipped into deep depression."
    },
    {
      "id": 23,
      "start": 58.26,
      "end": 60.16,
      "text": "Then, he came to me."
    },
    {
      "id": 24,
      "start": 60.16,
      "end": 63.54,
      "text": "When we analyzed why"
    },
    {
      "id": 25,
      "start": 63.54,
      "end": 65.98,
      "text": "he ended up like this,"
    },
    {
      "id": 26,
      "start": 65.98,
      "end": 68.96,
      "text": "the surrounding work environment"
    },
    {
      "id": 27,
      "start": 68.96,
      "end": 71.36,
      "text": "had a massive effect on him."
    },
    {
      "id": 28,
      "start": 71.36,
      "end": 73.96,
      "text": "He wanted to work happily,"
    },
    {
      "id": 29,
      "start": 73.96,
      "end": 76.22,
      "text": "was a knowledgeable person,"
    },
    {
      "id": 30,
      "start": 76.22,
      "end": 78.44,
      "text": "and friendly with everyone."
    },
    {
      "id": 31,
      "start": 78.44,
      "end": 81.62,
      "text": "Yet their intention to oust him"
    },
    {
      "id": 32,
      "start": 81.62,
      "end": 84.18,
      "text": "deeply impacted his life."
    },
    {
      "id": 33,
      "start": 84.18,
      "end": 87.16,
      "text": "It left a severe mark."
    }
  ]
}