{
  "language": "te",
  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 2.1,
      "text": "I handled a case study..."
    },
    {
      "id": 2,
      "start": 2.1,
      "end": 4.8,
      "text": "...about toxic managers and employees."
    },
    {
      "id": 3,
      "start": 4.8,
      "end": 8.2,
      "text": "I am Dr. Hema Prasad, Psychologist."
    },
    {
      "id": 4,
      "start": 8.2,
      "end": 10.9,
      "text": "I know a young boy..."
    },
    {
      "id": 5,
      "start": 10.9,
      "end": 13.5,
      "text": "...who was very smart."
    },
    {
      "id": 6,
      "start": 13.5,
      "end": 16.0,
      "text": "At a very young age,"
    },
    {
      "id": 7,
      "start": 16.0,
      "end": 19.8,
      "text": "he got an MNC job."
    },
    {
      "id": 8,
      "start": 19.8,
      "end": 22.8,
      "text": "As he was working there,"
    },
    {
      "id": 9,
      "start": 22.8,
      "end": 26.8,
      "text": "his colleagues were much older."
    },
    {
      "id": 10,
      "start": 26.8,
      "end": 30.1,
      "text": "When he performed so well,"
    },
    {
      "id": 11,
      "start": 30.1,
      "end": 33.3,
      "text": "and did his job well,"
    },
    {
      "id": 12,
      "start": 33.3,
      "end": 35.8,
      "text": "his salary kept increasing."
    },
    {
      "id": 13,
      "start": 35.8,
      "end": 38.0,
      "text": "Compared to his colleagues,"
    },
    {
      "id": 14,
      "start": 38.0,
      "end": 40.5,
      "text": "his salary was double."
    },
    {
      "id": 15,
      "start": 40.5,
      "end": 42.5,
      "text": "They felt very jealous..."
    },
    {
      "id": 16,
      "start": 42.5,
      "end": 45.3,
      "text": "...and constantly criticized him."
    },
    {
      "id": 17,
      "start": 45.3,
      "end": 48.0,
      "text": "Right to his face,"
    },
    {
      "id": 18,
      "start": 48.0,
      "end": 50.0,
      "text": "they used vulgar language"
    },
    {
      "id": 19,
      "start": 50.0,
      "end": 52.5,
      "text": "and abused him constantly."
    },
    {
      "id": 20,
      "start": 52.5,
      "end": 55.8,
      "text": "This drove him into depression."
    },
    {
      "id": 21,
      "start": 55.8,
      "end": 58.7,
      "text": "Later, he came to me."
    },
    {
      "id": 22,
      "start": 58.7,
      "end": 61.3,
      "text": "After he came to me,"
    },
    {
      "id": 23,
      "start": 61.3,
      "end": 65.1,
      "text": "when we analyzed the situation,"
    },
    {
      "id": 24,
      "start": 65.1,
      "end": 67.7,
      "text": "the work environment around him..."
    },
    {
      "id": 25,
      "start": 67.7,
      "end": 70.8,
      "text": "He just wanted to work happily."
    },
    {
      "id": 26,
      "start": 70.8,
      "end": 73.6,
      "text": "He was very knowledgeable"
    },
    {
      "id": 27,
      "start": 73.6,
      "end": 76.8,
      "text": "and collaborated with everyone."
    },
    {
      "id": 28,
      "start": 76.8,
      "end": 80.1,
      "text": "Their goal to push him out"
    },
    {
      "id": 29,
      "start": 80.1,
      "end": 83.0,
      "text": "and the toxic thoughts around"
    },
    {
      "id": 30,
      "start": 83.0,
      "end": 87.1,
      "text": "severely impacted his life."
    }
  ]
}