{
  "language": "te",
  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 2.5,
      "text": "When should an employee"
    },
    {
      "id": 2,
      "start": 2.5,
      "end": 4.18,
      "text": "consult a psychologist"
    },
    {
      "id": 3,
      "start": 4.18,
      "end": 5.92,
      "text": "or a psychiatrist?"
    },
    {
      "id": 4,
      "start": 5.92,
      "end": 7.3,
      "text": "Let's see."
    },
    {
      "id": 5,
      "start": 7.3,
      "end": 9.38,
      "text": "I am Dr. Hyma Prasad,"
    },
    {
      "id": 6,
      "start": 9.38,
      "end": 10.96,
      "text": "a Psychologist."
    },
    {
      "id": 7,
      "start": 10.96,
      "end": 13.06,
      "text": "How can an employee"
    },
    {
      "id": 8,
      "start": 13.06,
      "end": 15.68,
      "text": "know they are stressed?"
    },
    {
      "id": 9,
      "start": 15.68,
      "end": 19.34,
      "text": "If they were active earlier,"
    },
    {
      "id": 10,
      "start": 19.34,
      "end": 22.0,
      "text": "and after joining,"
    },
    {
      "id": 11,
      "start": 22.0,
      "end": 24.28,
      "text": "say within a month,"
    },
    {
      "id": 12,
      "start": 24.28,
      "end": 25.86,
      "text": "they start feeling dull,"
    },
    {
      "id": 13,
      "start": 25.86,
      "end": 28.34,
      "text": "cannot work properly,"
    },
    {
      "id": 14,
      "start": 28.34,
      "end": 31.42,
      "text": "cannot grasp anything assigned,"
    },
    {
      "id": 15,
      "start": 31.42,
      "end": 34.0,
      "text": "either sleeping too much"
    },
    {
      "id": 16,
      "start": 34.0,
      "end": 36.4,
      "text": "or having insomnia,"
    },
    {
      "id": 17,
      "start": 36.4,
      "end": 38.64,
      "text": "forgetting skills"
    },
    {
      "id": 18,
      "start": 38.64,
      "end": 41.34,
      "text": "they already know,"
    },
    {
      "id": 19,
      "start": 41.34,
      "end": 43.86,
      "text": "ignoring everything,"
    },
    {
      "id": 20,
      "start": 43.86,
      "end": 46.52,
      "text": "unable to mingle with anyone,"
    },
    {
      "id": 21,
      "start": 46.52,
      "end": 48.74,
      "text": "loss of appetite"
    },
    {
      "id": 22,
      "start": 48.74,
      "end": 51.52,
      "text": "or overeating,"
    },
    {
      "id": 23,
      "start": 51.52,
      "end": 54.34,
      "text": "as well as physiological issues"
    },
    {
      "id": 24,
      "start": 54.34,
      "end": 56.66,
      "text": "like severe gastritis,"
    },
    {
      "id": 25,
      "start": 56.66,
      "end": 58.28,
      "text": "constipation,"
    },
    {
      "id": 26,
      "start": 58.28,
      "end": 60.84,
      "text": "or other physical ailments,"
    },
    {
      "id": 27,
      "start": 60.84,
      "end": 64.9,
      "text": "which ruin concentration,"
    },
    {
      "id": 28,
      "start": 64.9,
      "end": 67.58,
      "text": "when you have these symptoms"
    },
    {
      "id": 29,
      "start": 67.58,
      "end": 70.36,
      "text": "and feel unable to work"
    },
    {
      "id": 30,
      "start": 70.36,
      "end": 73.5,
      "text": "properly at your workplace,"
    },
    {
      "id": 31,
      "start": 73.5,
      "end": 75.8,
      "text": "meeting a counselor"
    },
    {
      "id": 32,
      "start": 75.8,
      "end": 78.44,
      "text": "and taking timely counseling"
    },
    {
      "id": 33,
      "start": 78.44,
      "end": 81.36,
      "text": "will help you recover easily"
    },
    {
      "id": 34,
      "start": 81.36,
      "end": 83.74,
      "text": "and become a great employee."
    },
    {
      "id": 35,
      "start": 83.74,
      "end": 86.0,
      "text": "Thank you."
    }
  ]
}