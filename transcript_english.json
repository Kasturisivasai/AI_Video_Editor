{
  "language": "te",
  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 1.8,
      "text": "Let's see the qualities"
    },
    {
      "id": 2,
      "start": 1.8,
      "end": 3.8,
      "text": "of a best employee."
    },
    {
      "id": 3,
      "start": 3.8,
      "end": 5.8,
      "text": "I am Dr. Hyma Prasad,"
    },
    {
      "id": 4,
      "start": 5.8,
      "end": 7.5,
      "text": "who is a psychologist."
    },
    {
      "id": 5,
      "start": 7.5,
      "end": 9.5,
      "text": "How should an employee"
    },
    {
      "id": 6,
      "start": 9.5,
      "end": 11.5,
      "text": "behave at their workplace?"
    },
    {
      "id": 7,
      "start": 11.5,
      "end": 14.5,
      "text": "They need good communication"
    },
    {
      "id": 8,
      "start": 14.5,
      "end": 17.0,
      "text": "and a proper way"
    },
    {
      "id": 9,
      "start": 17.0,
      "end": 20.0,
      "text": "of speaking with others."
    },
    {
      "id": 10,
      "start": 20.0,
      "end": 22.8,
      "text": "They should have gratitude"
    },
    {
      "id": 11,
      "start": 22.8,
      "end": 24.8,
      "text": "towards their job."
    },
    {
      "id": 12,
      "start": 24.8,
      "end": 26.8,
      "text": "Nowadays, many people"
    },
    {
      "id": 13,
      "start": 26.8,
      "end": 29.5,
      "text": "complain after getting employed."
    },
    {
      "id": 14,
      "start": 29.5,
      "end": 32.0,
      "text": "They feel highly dissatisfied."
    },
    {
      "id": 15,
      "start": 32.0,
      "end": 34.5,
      "text": "So, they should be grateful"
    },
    {
      "id": 16,
      "start": 34.5,
      "end": 36.8,
      "text": "for having a job"
    },
    {
      "id": 17,
      "start": 36.8,
      "end": 39.5,
      "text": "and treat it as divine."
    },
    {
      "id": 18,
      "start": 39.5,
      "end": 41.5,
      "text": "They must show gratitude."
    },
    {
      "id": 19,
      "start": 41.5,
      "end": 44.2,
      "text": "Along with dedication,"
    },
    {
      "id": 20,
      "start": 44.2,
      "end": 46.5,
      "text": "they should work"
    },
    {
      "id": 21,
      "start": 46.5,
      "end": 49.5,
      "text": "without delaying any tasks."
    },
    {
      "id": 22,
      "start": 49.5,
      "end": 51.5,
      "text": "They must prove"
    },
    {
      "id": 23,
      "start": 51.5,
      "end": 54.2,
      "text": "their inner capabilities"
    },
    {
      "id": 24,
      "start": 54.2,
      "end": 57.0,
      "text": "and learn new skills."
    },
    {
      "id": 25,
      "start": 57.0,
      "end": 60.0,
      "text": "They should practice patience"
    },
    {
      "id": 26,
      "start": 60.0,
      "end": 63.0,
      "text": "even if instructors get"
    },
    {
      "id": 27,
      "start": 63.0,
      "end": 66.0,
      "text": "annoyed or scold them."
    },
    {
      "id": 28,
      "start": 66.0,
      "end": 69.0,
      "text": "They must remain calm"
    },
    {
      "id": 29,
      "start": 69.0,
      "end": 72.5,
      "text": "and focus on learning."
    },
    {
      "id": 30,
      "start": 72.5,
      "end": 75.5,
      "text": "Developing these skills"
    },
    {
      "id": 31,
      "start": 75.5,
      "end": 78.5,
      "text": "boosts interest in work."
    },
    {
      "id": 32,
      "start": 78.5,
      "end": 81.0,
      "text": "Any employee with these"
    },
    {
      "id": 33,
      "start": 81.0,
      "end": 83.2,
      "text": "qualities will love"
    },
    {
      "id": 34,
      "start": 83.2,
      "end": 85.8,
      "text": "their job naturally."
    },
    {
      "id": 35,
      "start": 85.8,
      "end": 88.2,
      "text": "You must take up"
    },
    {
      "id": 36,
      "start": 88.2,
      "end": 91.5,
      "text": "every task as a challenge."
    },
    {
      "id": 37,
      "start": 91.5,
      "end": 94.5,
      "text": "By doing this,"
    },
    {
      "id": 38,
      "start": 94.5,
      "end": 97.8,
      "text": "you can easily reach"
    },
    {
      "id": 39,
      "start": 97.8,
      "end": 104.0,
      "text": "your desired high position."
    }
  ],
  "duration": 105.41
}