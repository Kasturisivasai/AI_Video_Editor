{
  "language": "te",
  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 1.9,
      "text": "I recently handled a case"
    },
    {
      "id": 2,
      "start": 1.9,
      "end": 4.2,
      "text": "about toxic managers and employees."
    },
    {
      "id": 3,
      "start": 4.2,
      "end": 6.0,
      "text": "I'll tell you about it."
    },
    {
      "id": 4,
      "start": 6.0,
      "end": 8.1,
      "text": "I am Dr. Hyma Prasad, psychologist."
    },
    {
      "id": 5,
      "start": 10.0,
      "end": 12.2,
      "text": "A young guy I know,"
    },
    {
      "id": 6,
      "start": 12.2,
      "end": 13.8,
      "text": "who was very smart,"
    },
    {
      "id": 7,
      "start": 13.8,
      "end": 16.3,
      "text": "landed a top MNC job"
    },
    {
      "id": 8,
      "start": 16.3,
      "end": 18.2,
      "text": "at a very young age."
    },
    {
      "id": 9,
      "start": 20.0,
      "end": 22.0,
      "text": "While he was working,"
    },
    {
      "id": 10,
      "start": 22.0,
      "end": 24.3,
      "text": "everyone around him"
    },
    {
      "id": 11,
      "start": 24.3,
      "end": 26.3,
      "text": "was much older than him."
    },
    {
      "id": 12,
      "start": 27.0,
      "end": 29.1,
      "text": "As he performed really well"
    },
    {
      "id": 13,
      "start": 29.1,
      "end": 31.8,
      "text": "and excelled at his work,"
    },
    {
      "id": 14,
      "start": 31.8,
      "end": 35.1,
      "text": "his salary got hiked regularly."
    },
    {
      "id": 15,
      "start": 35.8,
      "end": 37.8,
      "text": "Compared to others,"
    },
    {
      "id": 16,
      "start": 37.8,
      "end": 40.0,
      "text": "he earned double the salary."
    },
    {
      "id": 17,
      "start": 40.0,
      "end": 42.1,
      "text": "Out of extreme jealousy,"
    },
    {
      "id": 18,
      "start": 42.1,
      "end": 44.1,
      "text": "they constantly criticized him."
    },
    {
      "id": 19,
      "start": 44.1,
      "end": 47.9,
      "text": "He faced vulgar language,"
    },
    {
      "id": 20,
      "start": 47.9,
      "end": 50.8,
      "text": "abuse, and harassment."
    },
    {
      "id": 21,
      "start": 50.8,
      "end": 53.6,
      "text": "As a result of this,"
    },
    {
      "id": 22,
      "start": 53.6,
      "end": 55.7,
      "text": "he fell into severe depression."
    },
    {
      "id": 23,
      "start": 55.7,
      "end": 58.1,
      "text": "Then he came to me"
    },
    {
      "id": 24,
      "start": 58.1,
      "end": 60.1,
      "text": "for psychological counseling."
    },
    {
      "id": 25,
      "start": 60.1,
      "end": 62.1,
      "text": "When I analyzed"
    },
    {
      "id": 26,
      "start": 62.1,
      "end": 64.9,
      "text": "why he ended up like this,"
    },
    {
      "id": 27,
      "start": 65.0,
      "end": 67.8,
      "text": "it was the toxic environment."
    },
    {
      "id": 28,
      "start": 67.8,
      "end": 70.0,
      "text": "He joined enthusiastically,"
    },
    {
      "id": 29,
      "start": 70.0,
      "end": 72.3,
      "text": "being a knowledgeable,"
    },
    {
      "id": 30,
      "start": 72.3,
      "end": 74.5,
      "text": "friendly, and happy person."
    },
    {
      "id": 31,
      "start": 74.5,
      "end": 77.2,
      "text": "But their relentless push"
    },
    {
      "id": 32,
      "start": 77.2,
      "end": 79.2,
      "text": "to drive him out"
    },
    {
      "id": 33,
      "start": 79.2,
      "end": 81.9,
      "text": "severely impacted his life."
    }
  ]
}