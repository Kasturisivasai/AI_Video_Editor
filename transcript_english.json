{
  "language": "te",
  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 3.1,
      "text": "Due to poor communication,"
    },
    {
      "id": 2,
      "start": 3.1,
      "end": 5.8,
      "text": "life becomes very difficult."
    },
    {
      "id": 3,
      "start": 5.8,
      "end": 8.0,
      "text": "I will tell you"
    },
    {
      "id": 4,
      "start": 8.0,
      "end": 10.2,
      "text": "about one such case."
    },
    {
      "id": 5,
      "start": 10.2,
      "end": 12.5,
      "text": "I am Dr. Hyma Prasad,"
    },
    {
      "id": 6,
      "start": 12.5,
      "end": 14.5,
      "text": "I'm a psychologist."
    },
    {
      "id": 7,
      "start": 14.5,
      "end": 17.0,
      "text": "In my recent cases,"
    },
    {
      "id": 8,
      "start": 17.0,
      "end": 19.5,
      "text": "there was a boy."
    },
    {
      "id": 9,
      "start": 19.5,
      "end": 22.0,
      "text": "He studied very well,"
    },
    {
      "id": 10,
      "start": 22.0,
      "end": 24.2,
      "text": "got great marks,"
    },
    {
      "id": 11,
      "start": 24.2,
      "end": 26.8,
      "text": "everything was perfect."
    },
    {
      "id": 12,
      "start": 26.8,
      "end": 29.5,
      "text": "On record, he was excellent."
    },
    {
      "id": 13,
      "start": 29.5,
      "end": 31.8,
      "text": "He was very good."
    },
    {
      "id": 14,
      "start": 31.8,
      "end": 34.5,
      "text": "But when sitting to talk,"
    },
    {
      "id": 15,
      "start": 34.5,
      "end": 37.0,
      "text": "he feared English."
    },
    {
      "id": 16,
      "start": 37.0,
      "end": 39.8,
      "text": "He feared speaking to others."
    },
    {
      "id": 17,
      "start": 39.8,
      "end": 42.5,
      "text": "He feared going to coaching."
    },
    {
      "id": 18,
      "start": 42.5,
      "end": 45.0,
      "text": "With all these fears,"
    },
    {
      "id": 19,
      "start": 45.0,
      "end": 47.5,
      "text": "he couldn't face interviews."
    },
    {
      "id": 20,
      "start": 47.5,
      "end": 50.0,
      "text": "He went to interviews"
    },
    {
      "id": 21,
      "start": 50.0,
      "end": 52.8,
      "text": "and failed repeatedly."
    },
    {
      "id": 22,
      "start": 52.8,
      "end": 55.5,
      "text": "Why is this happening?"
    },
    {
      "id": 23,
      "start": 55.5,
      "end": 58.2,
      "text": "Especially these days,"
    },
    {
      "id": 24,
      "start": 58.2,
      "end": 61.0,
      "text": "no one should fear English."
    },
    {
      "id": 25,
      "start": 61.0,
      "end": 64.0,
      "text": "Because you study in English."
    },
    {
      "id": 26,
      "start": 64.0,
      "end": 66.8,
      "text": "Even then, why fear?"
    },
    {
      "id": 27,
      "start": 66.8,
      "end": 69.5,
      "text": "Why is he scared?"
    },
    {
      "id": 28,
      "start": 69.5,
      "end": 72.8,
      "text": "He magnifies the interviews."
    },
    {
      "id": 29,
      "start": 72.8,
      "end": 75.8,
      "text": "He fears talking to anyone."
    },
    {
      "id": 30,
      "start": 75.8,
      "end": 78.5,
      "text": "Why does this happen?"
    },
    {
      "id": 31,
      "start": 78.5,
      "end": 81.2,
      "text": "You have the knowledge,"
    },
    {
      "id": 32,
      "start": 81.2,
      "end": 83.8,
      "text": "but can't explain it."
    },
    {
      "id": 33,
      "start": 83.8,
      "end": 86.8,
      "text": "So he failed many interviews."
    },
    {
      "id": 34,
      "start": 86.8,
      "end": 90.0,
      "text": "Here is how to practice."
    }
  ],
  "duration": 90.0053125
}