{
  "language": "te",
  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 2.12,
      "text": "Due to poor communication skills,"
    },
    {
      "id": 2,
      "start": 2.12,
      "end": 4.54,
      "text": "how difficult life becomes,"
    },
    {
      "id": 3,
      "start": 4.54,
      "end": 7.42,
      "text": "I will share a case."
    },
    {
      "id": 4,
      "start": 7.42,
      "end": 10.98,
      "text": "I am Dr. Hyma Prasad,"
    },
    {
      "id": 5,
      "start": 10.98,
      "end": 13.56,
      "text": "Psychologist."
    },
    {
      "id": 6,
      "start": 13.56,
      "end": 17.58,
      "text": "Among the cases I handled,"
    },
    {
      "id": 7,
      "start": 17.58,
      "end": 20.94,
      "text": "one boy had communication..."
    },
    {
      "id": 8,
      "start": 20.94,
      "end": 22.8,
      "text": "He studies very well,"
    },
    {
      "id": 9,
      "start": 22.8,
      "end": 24.84,
      "text": "gets good marks,"
    },
    {
      "id": 10,
      "start": 24.84,
      "end": 26.6,
      "text": "everything is great."
    },
    {
      "id": 11,
      "start": 26.6,
      "end": 28.56,
      "text": "His entire record is excellent."
    },
    {
      "id": 12,
      "start": 28.56,
      "end": 30.56,
      "text": "Very good, excellent."
    },
    {
      "id": 13,
      "start": 30.56,
      "end": 32.54,
      "text": "But when speaking,"
    },
    {
      "id": 14,
      "start": 32.54,
      "end": 34.88,
      "text": "he fears English."
    },
    {
      "id": 15,
      "start": 34.88,
      "end": 37.16,
      "text": "Afraid to talk to people."
    },
    {
      "id": 16,
      "start": 37.16,
      "end": 40.54,
      "text": "Afraid to attend coaching classes."
    },
    {
      "id": 17,
      "start": 40.54,
      "end": 43.18,
      "text": "With so many fears,"
    },
    {
      "id": 18,
      "start": 43.18,
      "end": 45.42,
      "text": "he couldn't face interviews."
    },
    {
      "id": 19,
      "start": 45.42,
      "end": 46.72,
      "text": "Attending interviews,"
    },
    {
      "id": 20,
      "start": 46.72,
      "end": 48.06,
      "text": "and getting rejected."
    },
    {
      "id": 21,
      "start": 48.06,
      "end": 49.96,
      "text": "Why is this happening?"
    },
    {
      "id": 22,
      "start": 49.96,
      "end": 52.82,
      "text": "Mainly, these days,"
    },
    {
      "id": 23,
      "start": 52.82,
      "end": 55.44,
      "text": "no need to fear English."
    },
    {
      "id": 24,
      "start": 55.44,
      "end": 58.74,
      "text": "Every subject is in English."
    },
    {
      "id": 25,
      "start": 58.74,
      "end": 60.9,
      "text": "Even so, why is he afraid?"
    },
    {
      "id": 26,
      "start": 60.9,
      "end": 63.88,
      "text": "Because..."
    },
    {
      "id": 27,
      "start": 63.88,
      "end": 66.82,
      "text": "he views interviews through a lens."
    },
    {
      "id": 28,
      "start": 66.82,
      "end": 70.36,
      "text": "Magnifying them with fear."
    },
    {
      "id": 29,
      "start": 70.36,
      "end": 73.1,
      "text": "You have the subject theoretically,"
    },
    {
      "id": 30,
      "start": 73.1,
      "end": 76.54,
      "text": "but lack the way to explain it."
    },
    {
      "id": 31,
      "start": 76.54,
      "end": 78.48,
      "text": "You know the subject,"
    },
    {
      "id": 32,
      "start": 78.48,
      "end": 80.52,
      "text": "you can explain it,"
    },
    {
      "id": 33,
      "start": 80.52,
      "end": 82.74,
      "text": "but cannot express it."
    },
    {
      "id": 34,
      "start": 82.74,
      "end": 85.34,
      "text": "Unable to express himself,"
    },
    {
      "id": 35,
      "start": 85.34,
      "end": 87.72,
      "text": "despite knowing all answers,"
    },
    {
      "id": 36,
      "start": 87.72,
      "end": 90.0,
      "text": "he failed many interviews."
    },
    {
      "id": 37,
      "start": 90.0,
      "end": 92.58,
      "text": "I'll tell you how to practice."
    }
  ]
}