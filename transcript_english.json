{
  "language": "te",
  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 2.1,
      "text": "Lack of communication skills..."
    },
    {
      "id": 2,
      "start": 2.1,
      "end": 4.2,
      "text": "...makes life very difficult."
    },
    {
      "id": 3,
      "start": 4.2,
      "end": 6.5,
      "text": "I'll share a case study."
    },
    {
      "id": 4,
      "start": 6.5,
      "end": 8.5,
      "text": "I am Dr. Hyma Prasad,"
    },
    {
      "id": 5,
      "start": 8.5,
      "end": 10.5,
      "text": "...a psychologist."
    },
    {
      "id": 6,
      "start": 10.5,
      "end": 13.5,
      "text": "In a recent case,"
    },
    {
      "id": 7,
      "start": 13.5,
      "end": 16.2,
      "text": "...a young boy struggled."
    },
    {
      "id": 8,
      "start": 16.2,
      "end": 19.1,
      "text": "He studied very well,"
    },
    {
      "id": 9,
      "start": 19.1,
      "end": 21.8,
      "text": "...got excellent marks,"
    },
    {
      "id": 10,
      "start": 21.8,
      "end": 25.2,
      "text": "...had a great record."
    },
    {
      "id": 11,
      "start": 25.2,
      "end": 28.1,
      "text": "But talking face-to-face,"
    },
    {
      "id": 12,
      "start": 28.1,
      "end": 31.5,
      "text": "...he feared English."
    },
    {
      "id": 13,
      "start": 31.5,
      "end": 34.2,
      "text": "He feared speaking up."
    },
    {
      "id": 14,
      "start": 34.2,
      "end": 37.8,
      "text": "Going to coaching scared him."
    },
    {
      "id": 15,
      "start": 37.8,
      "end": 40.5,
      "text": "Overwhelmed by these fears,"
    },
    {
      "id": 16,
      "start": 40.5,
      "end": 43.5,
      "text": "...he couldn't clear interviews."
    },
    {
      "id": 17,
      "start": 43.5,
      "end": 46.5,
      "text": "He faced continuous failures."
    },
    {
      "id": 18,
      "start": 46.5,
      "end": 48.8,
      "text": "Why is this happening?"
    },
    {
      "id": 19,
      "start": 48.8,
      "end": 52.8,
      "text": "Today, English shouldn't scare you."
    },
    {
      "id": 20,
      "start": 52.8,
      "end": 56.5,
      "text": "All subjects are in English."
    },
    {
      "id": 21,
      "start": 56.5,
      "end": 59.8,
      "text": "Yet, why this fear?"
    },
    {
      "id": 22,
      "start": 59.8,
      "end": 104.2,
      "text": "He exaggerates the interview fear."
    },
    {
      "id": 23,
      "start": 104.2,
      "end": 107.5,
      "text": "He has subject knowledge,"
    },
    {
      "id": 24,
      "start": 107.5,
      "end": 111.2,
      "text": "...but lacks presentation skills."
    },
    {
      "id": 25,
      "start": 111.2,
      "end": 114.2,
      "text": "He knows the answers,"
    },
    {
      "id": 26,
      "start": 114.2,
      "end": 117.2,
      "text": "...but fails to express."
    },
    {
      "id": 27,
      "start": 117.2,
      "end": 120.1,
      "text": "Despite knowing it all,"
    },
    {
      "id": 28,
      "start": 120.1,
      "end": 123.5,
      "text": "...he failed every interview."
    },
    {
      "id": 29,
      "start": 123.5,
      "end": 127.0,
      "text": "Here is how to practice."
    }
  ]
}