{
  "language": "te",
  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 2.16,
      "text": "What makes a great"
    },
    {
      "id": 2,
      "start": 2.16,
      "end": 4.14,
      "text": "employee stand out?"
    },
    {
      "id": 3,
      "start": 4.14,
      "end": 6.84,
      "text": "I am Dr. Hyma Prasad,"
    },
    {
      "id": 4,
      "start": 6.84,
      "end": 8.76,
      "text": "a Psychologist."
    },
    {
      "id": 5,
      "start": 9.42,
      "end": 12.06,
      "text": "How should an employee"
    },
    {
      "id": 6,
      "start": 12.06,
      "end": 14.56,
      "text": "conduct themselves"
    },
    {
      "id": 7,
      "start": 14.56,
      "end": 16.92,
      "text": "in their workplace?"
    },
    {
      "id": 8,
      "start": 16.92,
      "end": 19.32,
      "text": "Communication must be clear."
    },
    {
      "id": 9,
      "start": 19.32,
      "end": 22.84,
      "text": "Speak properly with everyone."
    },
    {
      "id": 10,
      "start": 23.46,
      "end": 25.56,
      "text": "Be grateful"
    },
    {
      "id": 11,
      "start": 25.56,
      "end": 27.52,
      "text": "for your job."
    },
    {
      "id": 12,
      "start": 27.52,
      "end": 29.84,
      "text": "Many people desperately"
    },
    {
      "id": 13,
      "start": 29.84,
      "end": 31.96,
      "text": "want a job,"
    },
    {
      "id": 14,
      "start": 31.96,
      "end": 34.02,
      "text": "yet complain once hired."
    },
    {
      "id": 15,
      "start": 34.02,
      "end": 36.42,
      "text": "Discontent is common today."
    },
    {
      "id": 16,
      "start": 36.88,
      "end": 39.84,
      "text": "Instead, thank God"
    },
    {
      "id": 17,
      "start": 39.84,
      "end": 42.12,
      "text": "for this opportunity."
    },
    {
      "id": 18,
      "start": 42.12,
      "end": 44.52,
      "text": "Treat work as worship"
    },
    {
      "id": 19,
      "start": 44.52,
      "end": 46.54,
      "text": "and show gratitude."
    },
    {
      "id": 20,
      "start": 46.86,
      "end": 48.9,
      "text": "Dedication is essential."
    },
    {
      "id": 21,
      "start": 48.9,
      "end": 52.88,
      "text": "Do your work without delays."
    },
    {
      "id": 22,
      "start": 53.64,
      "end": 56.66,
      "text": "Demonstrate your true potential"
    },
    {
      "id": 23,
      "start": 56.66,
      "end": 59.88,
      "text": "and prove your capability."
    },
    {
      "id": 24,
      "start": 60.14,
      "end": 62.74,
      "text": "Keep learning new skills"
    },
    {
      "id": 25,
      "start": 62.74,
      "end": 65.5,
      "text": "and practice patience."
    },
    {
      "id": 26,
      "start": 65.5,
      "end": 68.64,
      "text": "Mentors may get annoyed,"
    },
    {
      "id": 27,
      "start": 68.64,
      "end": 71.02,
      "text": "people have moods."
    },
    {
      "id": 28,
      "start": 71.02,
      "end": 73.12,
      "text": "Stay calm around them,"
    },
    {
      "id": 29,
      "start": 73.12,
      "end": 75.72,
      "text": "absorb the knowledge,"
    },
    {
      "id": 30,
      "start": 75.72,
      "end": 77.92,
      "text": "and develop your skills."
    },
    {
      "id": 31,
      "start": 78.44,
      "end": 81.36,
      "text": "When you upskill yourself,"
    },
    {
      "id": 32,
      "start": 81.36,
      "end": 84.88,
      "text": "job passion naturally rises."
    },
    {
      "id": 33,
      "start": 85.04,
      "end": 87.72,
      "text": "Whatever your job role,"
    },
    {
      "id": 34,
      "start": 87.72,
      "end": 90.62,
      "text": "nurturing these habits"
    },
    {
      "id": 35,
      "start": 90.62,
      "end": 93.36,
      "text": "sparks genuine love for work."
    },
    {
      "id": 36,
      "start": 93.36,
      "end": 96.06,
      "text": "Love what you do,"
    },
    {
      "id": 37,
      "start": 96.06,
      "end": 99.22,
      "text": "embrace every challenge,"
    },
    {
      "id": 38,
      "start": 99.22,
      "end": 101.9,
      "text": "and you will easily"
    },
    {
      "id": 39,
      "start": 101.9,
      "end": 104.9,
      "text": "reach your dream position."
    }
  ]
}