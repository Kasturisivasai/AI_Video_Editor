{
  "language": "te",
  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 2.22,
      "text": "Let's look at the qualities"
    },
    {
      "id": 2,
      "start": 2.22,
      "end": 4.14,
      "text": "of a best employee."
    },
    {
      "id": 3,
      "start": 4.14,
      "end": 6.84,
      "text": "I am Dr. Hyma Prasad,"
    },
    {
      "id": 4,
      "start": 6.84,
      "end": 8.52,
      "text": "Psychologist."
    },
    {
      "id": 5,
      "start": 8.52,
      "end": 12.38,
      "text": "How should an employee,"
    },
    {
      "id": 6,
      "start": 12.38,
      "end": 14.88,
      "text": "that is, a person,"
    },
    {
      "id": 7,
      "start": 14.88,
      "end": 17.62,
      "text": "behave at work?"
    },
    {
      "id": 8,
      "start": 17.62,
      "end": 20.06,
      "text": "They must communicate well."
    },
    {
      "id": 9,
      "start": 20.06,
      "end": 23.32,
      "text": "Speak properly with everyone."
    },
    {
      "id": 10,
      "start": 23.32,
      "end": 25.86,
      "text": "Then, show gratitude"
    },
    {
      "id": 11,
      "start": 25.86,
      "end": 27.68,
      "text": "towards the job."
    },
    {
      "id": 12,
      "start": 27.68,
      "end": 30.68,
      "text": "Nowadays, many people"
    },
    {
      "id": 13,
      "start": 30.68,
      "end": 32.74,
      "text": "desperately want a job,"
    },
    {
      "id": 14,
      "start": 32.74,
      "end": 35.14,
      "text": "but once they get it,"
    },
    {
      "id": 15,
      "start": 35.14,
      "end": 36.96,
      "text": "they express dissatisfaction"
    },
    {
      "id": 16,
      "start": 36.96,
      "end": 39.84,
      "text": "about having that job."
    },
    {
      "id": 17,
      "start": 39.84,
      "end": 42.66,
      "text": "Instead, be grateful to God"
    },
    {
      "id": 18,
      "start": 42.66,
      "end": 45.48,
      "text": "for giving this job."
    },
    {
      "id": 19,
      "start": 45.48,
      "end": 47.98,
      "text": "Treat your work like worship"
    },
    {
      "id": 20,
      "start": 47.98,
      "end": 49.88,
      "text": "and show gratitude."
    },
    {
      "id": 21,
      "start": 49.88,
      "end": 52.32,
      "text": "Along with that,"
    },
    {
      "id": 22,
      "start": 52.32,
      "end": 54.12,
      "text": "have true dedication."
    },
    {
      "id": 23,
      "start": 54.12,
      "end": 56.66,
      "text": "Finish work without delays."
    },
    {
      "id": 24,
      "start": 56.66,
      "end": 59.98,
      "text": "Demonstrate your full ability"
    },
    {
      "id": 25,
      "start": 59.98,
      "end": 62.46,
      "text": "and prove your potential."
    },
    {
      "id": 26,
      "start": 62.46,
      "end": 64.9,
      "text": "Also, learn new skills"
    },
    {
      "id": 27,
      "start": 64.9,
      "end": 67.24,
      "text": "and cultivate patience."
    },
    {
      "id": 28,
      "start": 67.24,
      "end": 70.38,
      "text": "Trainers may get annoyed,"
    },
    {
      "id": 29,
      "start": 70.38,
      "end": 72.82,
      "text": "scold you, or get irritated."
    },
    {
      "id": 30,
      "start": 72.82,
      "end": 75.64,
      "text": "Stay patient with them,"
    },
    {
      "id": 31,
      "start": 75.64,
      "end": 78.46,
      "text": "learn your work thoroughly,"
    },
    {
      "id": 32,
      "start": 78.46,
      "end": 81.34,
      "text": "and develop your skills."
    },
    {
      "id": 33,
      "start": 81.34,
      "end": 84.14,
      "text": "Once skills develop,"
    },
    {
      "id": 34,
      "start": 84.14,
      "end": 86.82,
      "text": "interest in the job"
    },
    {
      "id": 35,
      "start": 86.82,
      "end": 88.82,
      "text": "naturally increases."
    },
    {
      "id": 36,
      "start": 88.82,
      "end": 91.24,
      "text": "Any employee who"
    },
    {
      "id": 37,
      "start": 91.24,
      "end": 93.38,
      "text": "nurtures these qualities"
    },
    {
      "id": 38,
      "start": 93.38,
      "end": 95.8,
      "text": "will automatically"
    },
    {
      "id": 39,
      "start": 95.8,
      "end": 98.24,
      "text": "love their job."
    },
    {
      "id": 40,
      "start": 98.24,
      "end": 100.74,
      "text": "Embrace every challenge"
    },
    {
      "id": 41,
      "start": 100.74,
      "end": 103.14,
      "text": "in your job willingly."
    },
    {
      "id": 42,
      "start": 103.14,
      "end": 105.88,
      "text": "When you do that,"
    },
    {
      "id": 43,
      "start": 105.88,
      "end": 108.62,
      "text": "whatever position you desire,"
    },
    {
      "id": 44,
      "start": 108.62,
      "end": 111.36,
      "text": "you can easily achieve."
    }
  ]
}