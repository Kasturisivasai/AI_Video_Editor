Dialogue: 0,0:00:00.00,0:00:02.16,ReelSub,,0,0,0,,LET'S SEE THE QUALITIES
Dialogue: 0,0:00:02.16,0:00:04.54,ReelSub,,0,0,0,,OF A BEST {\c&H0000E6FF&}EMPLOYEE{\c&H00FFFFFF&}.
Dialogue: 0,0:00:04.54,0:00:07.02,ReelSub,,0,0,0,,I AM DR. HEMA PRASAD,
Dialogue: 0,0:00:07.02,0:00:08.52,ReelSub,,0,0,0,,A PSYCHOLOGIST.
Dialogue: 0,0:00:08.52,0:00:11.78,ReelSub,,0,0,0,,WHEN AN {\c&H0000E6FF&}EMPLOYEE{\c&H00FFFFFF&},
Dialogue: 0,0:00:11.78,0:00:13.90,ReelSub,,0,0,0,,MEANING A PERSON,
Dialogue: 0,0:00:13.90,0:00:15.34,ReelSub,,0,0,0,,GOES TO THEIR JOB,
Dialogue: 0,0:00:15.34,0:00:17.58,ReelSub,,0,0,0,,HOW SHOULD THEY BEHAVE?
Dialogue: 0,0:00:17.58,0:00:20.08,ReelSub,,0,0,0,,THERE SHOULD BE GOOD {\c&H0000E6FF&}COMMUNICATION{\c&H00FFFFFF&}.
Dialogue: 0,0:00:20.08,0:00:23.36,ReelSub,,0,0,0,,SPEAKING PROPERLY WITH OTHERS
Dialogue: 0,0:00:23.36,0:00:26.24,ReelSub,,0,0,0,,AND HAVING {\c&H0000E6FF&}GRATITUDE{\c&H00FFFFFF&}
Dialogue: 0,0:00:26.24,0:00:27.98,ReelSub,,0,0,0,,TOWARDS THEIR JOB.
Dialogue: 0,0:00:27.98,0:00:30.68,ReelSub,,0,0,0,,NOWADAYS WE SEE MANY PEOPLE,
Dialogue: 0,0:00:30.68,0:00:32.74,ReelSub,,0,0,0,,UNTIL THEY GET A JOB,
Dialogue: 0,0:00:32.74,0:00:34.78,ReelSub,,0,0,0,,THEY YEARN FOR ONE.
Dialogue: 0,0:00:34.78,0:00:36.32,ReelSub,,0,0,0,,ONCE THEY GET IT,
Dialogue: 0,0:00:36.32,0:00:38.08,ReelSub,,0,0,0,,THEY FEEL DISCONTENTED,
Dialogue: 0,0:00:38.08,0:00:41.24,ReelSub,,0,0,0,,COMPLAINING ABOUT IT.
Dialogue: 0,0:00:41.24,0:00:43.62,ReelSub,,0,0,0,,SO, BEING GRATEFUL TO GOD
Dialogue: 0,0:00:43.62,0:00:46.22,ReelSub,,0,0,0,,FOR GETTING SUCH A JOB,
Dialogue: 0,0:00:46.22,0:00:48.68,ReelSub,,0,0,0,,TREATING WORK AS DIVINE,
Dialogue: 0,0:00:48.68,0:00:50.80,ReelSub,,0,0,0,,THEY SHOULD SHOW {\c&H0000E6FF&}GRATITUDE{\c&H00FFFFFF&}.
Dialogue: 0,0:00:50.80,0:00:52.88,ReelSub,,0,0,0,,ALONG WITH THAT,
Dialogue: 0,0:00:52.88,0:00:54.70,ReelSub,,0,0,0,,THERE MUST BE {\c&H0000E6FF&}DEDICATION{\c&H00FFFFFF&}.
Dialogue: 0,0:00:54.70,0:00:57.06,ReelSub,,0,0,0,,WORKING WITHOUT PROCRASTINATION,
Dialogue: 0,0:00:57.06,0:00:59.84,ReelSub,,0,0,0,,DEMONSTRATING THE FULL EXTENT
Dialogue: 0,0:00:59.84,0:01:02.24,ReelSub,,0,0,0,,OF THEIR TRUE POTENTIAL.
Dialogue: 0,0:01:02.24,0:01:04.90,ReelSub,,0,0,0,,ALSO LEARNING NEW SKILLS,
Dialogue: 0,0:01:04.90,0:01:07.24,ReelSub,,0,0,0,,AND DEVELOPING {\c&H0000E6FF&}PATIENCE{\c&H00FFFFFF&}.
Dialogue: 0,0:01:07.24,0:01:09.52,ReelSub,,0,0,0,,THOSE WHO TEACH YOU
Dialogue: 0,0:01:09.52,0:01:11.90,ReelSub,,0,0,0,,MIGHT BE HARSH OR STRICT,
Dialogue: 0,0:01:11.90,0:01:13.82,ReelSub,,0,0,0,,STAYING PATIENT WITH THEM,
Dialogue: 0,0:01:13.82,0:01:15.84,ReelSub,,0,0,0,,LEARNING YOUR WORK,
Dialogue: 0,0:01:15.84,0:01:18.46,ReelSub,,0,0,0,,AND DEVELOPING SKILLS.
Dialogue: 0,0:01:18.46,0:01:21.36,ReelSub,,0,0,0,,ONCE SKILL DEVELOPMENT HAPPENS,
Dialogue: 0,0:01:21.36,0:01:23.90,ReelSub,,0,0,0,,AUTOMATICALLY THE INTEREST
Dialogue: 0,0:01:23.90,0:01:26.36,ReelSub,,0,0,0,,IN YOUR JOB GROWS.
Dialogue: 0,0:01:26.36,0:01:28.58,ReelSub,,0,0,0,,WHATEVER {\c&H0000E6FF&}EMPLOYEE{\c&H00FFFFFF&} YOU ARE,
Dialogue: 0,0:01:28.58,0:01:31.24,ReelSub,,0,0,0,,NURTURING THESE QUALITIES
Dialogue: 0,0:01:31.24,0:01:33.38,ReelSub,,0,0,0,,WILL AUTOMATICALLY BRING LOVE.
Dialogue: 0,0:01:33.38,0:01:35.30,ReelSub,,0,0,0,,YOU SHOULD LOVE YOUR JOB,
Dialogue: 0,0:01:35.30,0:01:37.40,ReelSub,,0,0,0,,AND TAKE EVERYTHING IN IT
Dialogue: 0,0:01:37.40,0:01:39.80,ReelSub,,0,0,0,,AS AN EXCITING CHALLENGE.
Dialogue: 0,0:01:39.80,0:01:42.16,ReelSub,,0,0,0,,THE DAY YOU DO THIS,
Dialogue: 0,0:01:42.16,0:01:44.56,ReelSub,,0,0,0,,WHATEVER DESIRED POSITION,
Dialogue: 0,0:01:44.56,0:01:47.00,ReelSub,,0,0,0,,YOU WANT TO REACH,
Dialogue: 0,0:01:47.00,0:01:49.12,ReelSub,,0,0,0,,YOU CAN EASILY ATTAIN.
