Dialogue: 0,0:00:00.00,0:00:02.22,ReelSub,,0,0,0,,LET'S LOOK AT THE QUALITIES
Dialogue: 0,0:00:02.22,0:00:04.14,ReelSub,,0,0,0,,OF A BEST EMPLOYEE.
Dialogue: 0,0:00:04.14,0:00:06.84,ReelSub,,0,0,0,,I AM DR. HYMA PRASAD,
Dialogue: 0,0:00:06.84,0:00:08.52,ReelSub,,0,0,0,,PSYCHOLOGIST.
Dialogue: 0,0:00:08.52,0:00:12.38,ReelSub,,0,0,0,,HOW SHOULD AN EMPLOYEE,
Dialogue: 0,0:00:12.38,0:00:14.88,ReelSub,,0,0,0,,THAT IS, A PERSON,
Dialogue: 0,0:00:14.88,0:00:17.62,ReelSub,,0,0,0,,BEHAVE AT WORK?
Dialogue: 0,0:00:17.62,0:00:20.06,ReelSub,,0,0,0,,THEY MUST COMMUNICATE WELL.
Dialogue: 0,0:00:20.06,0:00:23.32,ReelSub,,0,0,0,,SPEAK PROPERLY WITH EVERYONE.
Dialogue: 0,0:00:23.32,0:00:25.86,ReelSub,,0,0,0,,THEN, SHOW GRATITUDE
Dialogue: 0,0:00:25.86,0:00:27.68,ReelSub,,0,0,0,,TOWARDS THE JOB.
Dialogue: 0,0:00:27.68,0:00:30.68,ReelSub,,0,0,0,,NOWADAYS, MANY PEOPLE
Dialogue: 0,0:00:30.68,0:00:32.74,ReelSub,,0,0,0,,DESPERATELY WANT A JOB,
Dialogue: 0,0:00:32.74,0:00:35.14,ReelSub,,0,0,0,,BUT ONCE THEY GET IT,
Dialogue: 0,0:00:35.14,0:00:36.96,ReelSub,,0,0,0,,THEY EXPRESS DISSATISFACTION
Dialogue: 0,0:00:36.96,0:00:39.84,ReelSub,,0,0,0,,ABOUT HAVING THAT JOB.
Dialogue: 0,0:00:39.84,0:00:42.66,ReelSub,,0,0,0,,INSTEAD, BE GRATEFUL TO GOD
Dialogue: 0,0:00:42.66,0:00:45.48,ReelSub,,0,0,0,,FOR GIVING THIS JOB.
Dialogue: 0,0:00:45.48,0:00:47.98,ReelSub,,0,0,0,,TREAT YOUR WORK LIKE WORSHIP
Dialogue: 0,0:00:47.98,0:00:49.88,ReelSub,,0,0,0,,AND SHOW GRATITUDE.
Dialogue: 0,0:00:49.88,0:00:52.32,ReelSub,,0,0,0,,ALONG WITH THAT,
Dialogue: 0,0:00:52.32,0:00:54.12,ReelSub,,0,0,0,,HAVE TRUE DEDICATION.
Dialogue: 0,0:00:54.12,0:00:56.66,ReelSub,,0,0,0,,FINISH WORK WITHOUT DELAYS.
Dialogue: 0,0:00:56.66,0:00:59.98,ReelSub,,0,0,0,,DEMONSTRATE YOUR FULL ABILITY
Dialogue: 0,0:00:59.98,0:01:02.46,ReelSub,,0,0,0,,AND PROVE YOUR POTENTIAL.
Dialogue: 0,0:01:02.46,0:01:04.90,ReelSub,,0,0,0,,ALSO, LEARN NEW SKILLS
Dialogue: 0,0:01:04.90,0:01:07.24,ReelSub,,0,0,0,,AND CULTIVATE PATIENCE.
Dialogue: 0,0:01:07.24,0:01:10.38,ReelSub,,0,0,0,,TRAINERS MAY GET ANNOYED,
Dialogue: 0,0:01:10.38,0:01:12.82,ReelSub,,0,0,0,,SCOLD YOU, OR GET IRRITATED.
Dialogue: 0,0:01:12.82,0:01:15.64,ReelSub,,0,0,0,,STAY PATIENT WITH THEM,
Dialogue: 0,0:01:15.64,0:01:18.46,ReelSub,,0,0,0,,LEARN YOUR WORK THOROUGHLY,
Dialogue: 0,0:01:18.46,0:01:21.34,ReelSub,,0,0,0,,AND DEVELOP YOUR SKILLS.
Dialogue: 0,0:01:21.34,0:01:24.14,ReelSub,,0,0,0,,ONCE SKILLS DEVELOP,
Dialogue: 0,0:01:24.14,0:01:26.82,ReelSub,,0,0,0,,INTEREST IN THE JOB
Dialogue: 0,0:01:26.82,0:01:28.82,ReelSub,,0,0,0,,NATURALLY INCREASES.
Dialogue: 0,0:01:28.82,0:01:31.24,ReelSub,,0,0,0,,ANY EMPLOYEE WHO
Dialogue: 0,0:01:31.24,0:01:33.38,ReelSub,,0,0,0,,NURTURES THESE QUALITIES
Dialogue: 0,0:01:33.38,0:01:35.80,ReelSub,,0,0,0,,WILL AUTOMATICALLY
Dialogue: 0,0:01:35.80,0:01:38.24,ReelSub,,0,0,0,,LOVE THEIR JOB.
Dialogue: 0,0:01:38.24,0:01:40.74,ReelSub,,0,0,0,,EMBRACE EVERY CHALLENGE
Dialogue: 0,0:01:40.74,0:01:43.14,ReelSub,,0,0,0,,IN YOUR JOB WILLINGLY.
Dialogue: 0,0:01:43.14,0:01:45.88,ReelSub,,0,0,0,,WHEN YOU DO THAT,
Dialogue: 0,0:01:45.88,0:01:48.62,ReelSub,,0,0,0,,WHATEVER POSITION YOU DESIRE,
Dialogue: 0,0:01:48.62,0:01:51.36,ReelSub,,0,0,0,,YOU CAN EASILY ACHIEVE.
Dialogue: 1,0:00:02.20,0:00:04.20,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}BEST EMPLOYEE
Dialogue: 1,0:00:17.60,0:00:19.60,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}COMMUNICATION
Dialogue: 1,0:00:35.10,0:00:37.10,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}DISSATISFACTION
Dialogue: 1,0:00:52.30,0:00:54.30,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}DEDICATION
Dialogue: 1,0:01:05.50,0:01:07.50,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}PATIENCE
Dialogue: 1,0:01:48.60,0:01:50.60,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}SUCCESS
