Dialogue: 0,0:00:00.08,0:00:02.40,ReelSub,,0,0,0,,I RECENTLY HANDLED A CASE
Dialogue: 0,0:00:02.40,0:00:04.54,ReelSub,,0,0,0,,ABOUT {\c&H0000E6FF&}TOXIC{\c&H00FFFFFF&} MANAGERS AND EMPLOYEES.
Dialogue: 0,0:00:04.54,0:00:06.00,ReelSub,,0,0,0,,I'LL TELL YOU ABOUT IT.
Dialogue: 0,0:00:06.00,0:00:08.52,ReelSub,,0,0,0,,I AM DR. HYMA PRASAD, PSYCHOLOGIST.
Dialogue: 0,0:00:09.92,0:00:12.16,ReelSub,,0,0,0,,A BOY I KNOW,
Dialogue: 0,0:00:12.16,0:00:14.88,ReelSub,,0,0,0,,VERY SMART AT A YOUNG AGE,
Dialogue: 0,0:00:14.88,0:00:17.58,ReelSub,,0,0,0,,LANDED A GREAT MNC JOB.
Dialogue: 0,0:00:18.24,0:00:21.00,ReelSub,,0,0,0,,WHILE WORKING HIS JOB,
Dialogue: 0,0:00:21.00,0:00:23.96,ReelSub,,0,0,0,,THE PEOPLE AROUND HIM
Dialogue: 0,0:00:23.96,0:00:26.78,ReelSub,,0,0,0,,WERE QUITE SENIOR IN AGE.
Dialogue: 0,0:00:26.78,0:00:29.50,ReelSub,,0,0,0,,AS HE PERFORMED WELL
Dialogue: 0,0:00:29.50,0:00:32.72,ReelSub,,0,0,0,,AND CONTINUED HIS WORK,
Dialogue: 0,0:00:32.72,0:00:35.74,ReelSub,,0,0,0,,HIS {\c&H0000E6FF&}SALARY{\c&H00FFFFFF&} KEPT GETTING HIKED.
Dialogue: 0,0:00:35.80,0:00:37.94,ReelSub,,0,0,0,,COMPARED TO THEM,
Dialogue: 0,0:00:37.94,0:00:40.50,ReelSub,,0,0,0,,HE EARNED TWICE AS MUCH.
Dialogue: 0,0:00:40.50,0:00:42.18,ReelSub,,0,0,0,,THEY GREW JEALOUS OF HIM
Dialogue: 0,0:00:42.18,0:00:44.52,ReelSub,,0,0,0,,AND CONSTANTLY CRITICIZED HIM.
Dialogue: 0,0:00:44.52,0:00:47.46,ReelSub,,0,0,0,,RIGHT TO HIS FACE,
Dialogue: 0,0:00:47.46,0:00:50.18,ReelSub,,0,0,0,,THEY USED VULGAR LANGUAGE
Dialogue: 0,0:00:50.18,0:00:52.88,ReelSub,,0,0,0,,AND HURLED ABUSES AT HIM.
Dialogue: 0,0:00:53.04,0:00:55.76,ReelSub,,0,0,0,,BECAUSE OF THIS,
Dialogue: 0,0:00:55.76,0:00:58.26,ReelSub,,0,0,0,,HE SLIPPED INTO DEEP {\c&H0000E6FF&}DEPRESSION{\c&H00FFFFFF&}.
Dialogue: 0,0:00:58.26,0:01:00.16,ReelSub,,0,0,0,,THEN, HE CAME TO ME.
Dialogue: 0,0:01:00.16,0:01:03.54,ReelSub,,0,0,0,,WHEN WE ANALYZED WHY
Dialogue: 0,0:01:03.54,0:01:05.98,ReelSub,,0,0,0,,HE ENDED UP LIKE THIS,
Dialogue: 0,0:01:05.98,0:01:08.96,ReelSub,,0,0,0,,THE SURROUNDING WORK ENVIRONMENT
Dialogue: 0,0:01:08.96,0:01:11.36,ReelSub,,0,0,0,,HAD A MASSIVE EFFECT ON HIM.
Dialogue: 0,0:01:11.36,0:01:13.96,ReelSub,,0,0,0,,HE WANTED TO WORK HAPPILY,
Dialogue: 0,0:01:13.96,0:01:16.22,ReelSub,,0,0,0,,WAS A KNOWLEDGEABLE PERSON,
Dialogue: 0,0:01:16.22,0:01:18.44,ReelSub,,0,0,0,,AND FRIENDLY WITH EVERYONE.
Dialogue: 0,0:01:18.44,0:01:21.62,ReelSub,,0,0,0,,YET THEIR INTENTION TO OUST HIM
Dialogue: 0,0:01:21.62,0:01:24.18,ReelSub,,0,0,0,,DEEPLY IMPACTED HIS LIFE.
Dialogue: 0,0:01:24.18,0:01:27.16,ReelSub,,0,0,0,,IT LEFT A SEVERE MARK.
Dialogue: 1,0:00:02.40,0:00:04.54,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}TOXIC
Dialogue: 1,0:00:32.72,0:00:34.92,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}SALARY
Dialogue: 1,0:00:55.76,0:00:57.96,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}DEPRESSION
Dialogue: 1,0:00:37.94,0:00:40.14,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}EARNED TWICE
