Dialogue: 0,0:00:00.00,0:00:02.50,ReelSub,,0,0,0,,WHEN SHOULD AN EMPLOYEE
Dialogue: 0,0:00:02.50,0:00:04.18,ReelSub,,0,0,0,,CONSULT A PSYCHOLOGIST
Dialogue: 0,0:00:04.18,0:00:05.92,ReelSub,,0,0,0,,OR A PSYCHIATRIST?
Dialogue: 0,0:00:05.92,0:00:07.30,ReelSub,,0,0,0,,LET'S SEE.
Dialogue: 0,0:00:07.30,0:00:09.38,ReelSub,,0,0,0,,I AM DR. HYMA PRASAD,
Dialogue: 0,0:00:09.38,0:00:10.96,ReelSub,,0,0,0,,A PSYCHOLOGIST.
Dialogue: 0,0:00:10.96,0:00:13.06,ReelSub,,0,0,0,,HOW CAN AN EMPLOYEE
Dialogue: 0,0:00:13.06,0:00:15.68,ReelSub,,0,0,0,,KNOW THEY ARE STRESSED?
Dialogue: 0,0:00:15.68,0:00:19.34,ReelSub,,0,0,0,,IF THEY WERE ACTIVE EARLIER,
Dialogue: 0,0:00:19.34,0:00:22.00,ReelSub,,0,0,0,,AND AFTER JOINING,
Dialogue: 0,0:00:22.00,0:00:24.28,ReelSub,,0,0,0,,SAY WITHIN A MONTH,
Dialogue: 0,0:00:24.28,0:00:25.86,ReelSub,,0,0,0,,THEY START FEELING DULL,
Dialogue: 0,0:00:25.86,0:00:28.34,ReelSub,,0,0,0,,CANNOT WORK PROPERLY,
Dialogue: 0,0:00:28.34,0:00:31.42,ReelSub,,0,0,0,,CANNOT GRASP ANYTHING ASSIGNED,
Dialogue: 0,0:00:31.42,0:00:34.00,ReelSub,,0,0,0,,EITHER SLEEPING TOO MUCH
Dialogue: 0,0:00:34.00,0:00:36.40,ReelSub,,0,0,0,,OR HAVING INSOMNIA,
Dialogue: 0,0:00:36.40,0:00:38.64,ReelSub,,0,0,0,,FORGETTING SKILLS
Dialogue: 0,0:00:38.64,0:00:41.34,ReelSub,,0,0,0,,THEY ALREADY KNOW,
Dialogue: 0,0:00:41.34,0:00:43.86,ReelSub,,0,0,0,,IGNORING EVERYTHING,
Dialogue: 0,0:00:43.86,0:00:46.52,ReelSub,,0,0,0,,UNABLE TO MINGLE WITH ANYONE,
Dialogue: 0,0:00:46.52,0:00:48.74,ReelSub,,0,0,0,,LOSS OF APPETITE
Dialogue: 0,0:00:48.74,0:00:51.52,ReelSub,,0,0,0,,OR OVEREATING,
Dialogue: 0,0:00:51.52,0:00:54.34,ReelSub,,0,0,0,,AS WELL AS PHYSIOLOGICAL ISSUES
Dialogue: 0,0:00:54.34,0:00:56.66,ReelSub,,0,0,0,,LIKE SEVERE GASTRITIS,
Dialogue: 0,0:00:56.66,0:00:58.28,ReelSub,,0,0,0,,CONSTIPATION,
Dialogue: 0,0:00:58.28,0:01:00.84,ReelSub,,0,0,0,,OR OTHER PHYSICAL AILMENTS,
Dialogue: 0,0:01:00.84,0:01:04.90,ReelSub,,0,0,0,,WHICH RUIN CONCENTRATION,
Dialogue: 0,0:01:04.90,0:01:07.58,ReelSub,,0,0,0,,WHEN YOU HAVE THESE SYMPTOMS
Dialogue: 0,0:01:07.58,0:01:10.36,ReelSub,,0,0,0,,AND FEEL UNABLE TO WORK
Dialogue: 0,0:01:10.36,0:01:13.50,ReelSub,,0,0,0,,PROPERLY AT YOUR WORKPLACE,
Dialogue: 0,0:01:13.50,0:01:15.80,ReelSub,,0,0,0,,MEETING A COUNSELOR
Dialogue: 0,0:01:15.80,0:01:18.44,ReelSub,,0,0,0,,AND TAKING TIMELY COUNSELING
Dialogue: 0,0:01:18.44,0:01:21.36,ReelSub,,0,0,0,,WILL HELP YOU RECOVER EASILY
Dialogue: 0,0:01:21.36,0:01:23.74,ReelSub,,0,0,0,,AND BECOME A GREAT EMPLOYEE.
Dialogue: 0,0:01:23.74,0:01:26.00,ReelSub,,0,0,0,,THANK YOU.
Dialogue: 1,0:00:13.06,0:00:15.26,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}KNOW THEY
Dialogue: 1,0:00:24.28,0:00:25.86,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}THEY START
Dialogue: 1,0:00:34.00,0:00:36.20,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}HAVING INSOMNIA
