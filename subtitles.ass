Dialogue: 0,0:00:00.00,0:00:02.10,ReelSub,,0,0,0,,I RECENTLY HANDLED A CASE
Dialogue: 0,0:00:02.10,0:00:04.12,ReelSub,,0,0,0,,ABOUT {\c&H0000E6FF&}TOXIC{\c&H00FFFFFF&} MANAGERS AND EMPLOYEES.
Dialogue: 0,0:00:04.12,0:00:05.86,ReelSub,,0,0,0,,I WILL SHARE IT NOW.
Dialogue: 0,0:00:05.86,0:00:08.52,ReelSub,,0,0,0,,I AM DR. HYMA PRASAD, PSYCHOLOGIST.
Dialogue: 0,0:00:08.52,0:00:12.06,ReelSub,,0,0,0,,A YOUNG BOY I KNOW,
Dialogue: 0,0:00:12.06,0:00:14.88,ReelSub,,0,0,0,,WHO WAS VERY SMART,
Dialogue: 0,0:00:14.88,0:00:17.58,ReelSub,,0,0,0,,SECURED A JOB AT AN MNC
Dialogue: 0,0:00:17.58,0:00:19.50,ReelSub,,0,0,0,,AT A VERY YOUNG AGE.
Dialogue: 0,0:00:19.50,0:00:21.68,ReelSub,,0,0,0,,WHILE HE WAS WORKING THERE,
Dialogue: 0,0:00:21.68,0:00:24.28,ReelSub,,0,0,0,,HIS COLLEAGUES AT THE WORKPLACE
Dialogue: 0,0:00:24.28,0:00:26.68,ReelSub,,0,0,0,,WERE MUCH OLDER THAN HIM.
Dialogue: 0,0:00:26.68,0:00:29.58,ReelSub,,0,0,0,,AS HE PERFORMED REALLY WELL
Dialogue: 0,0:00:29.58,0:00:33.28,ReelSub,,0,0,0,,AND DELIVERED GOOD RESULTS,
Dialogue: 0,0:00:33.28,0:00:35.80,ReelSub,,0,0,0,,HIS {\c&H0000E6FF&}SALARY{\c&H00FFFFFF&} KEPT INCREASING.
Dialogue: 0,0:00:35.80,0:00:38.38,ReelSub,,0,0,0,,COMPARED TO HIS PEERS,
Dialogue: 0,0:00:38.38,0:00:40.82,ReelSub,,0,0,0,,HE EARNED TWICE AS MUCH.
Dialogue: 0,0:00:40.82,0:00:43.14,ReelSub,,0,0,0,,THIS MADE THEM FEEL JEALOUS,
Dialogue: 0,0:00:43.14,0:00:45.48,ReelSub,,0,0,0,,AND THEY CONSTANTLY CRITICIZED HIM.
Dialogue: 0,0:00:45.48,0:00:47.78,ReelSub,,0,0,0,,RIGHT IN FRONT OF HIM,
Dialogue: 0,0:00:47.78,0:00:50.40,ReelSub,,0,0,0,,THEY USED VULGAR LANGUAGE
Dialogue: 0,0:00:50.40,0:00:52.88,ReelSub,,0,0,0,,AND VERBALLY ABUSED HIM.
Dialogue: 0,0:00:52.88,0:00:55.60,ReelSub,,0,0,0,,THIS PUSHED HIM INTO {\c&H0000E6FF&}DEPRESSION{\c&H00FFFFFF&}.
Dialogue: 0,0:00:55.60,0:00:58.74,ReelSub,,0,0,0,,LATER, HE CAME TO CONSULT ME.
Dialogue: 0,0:00:58.74,0:01:01.98,ReelSub,,0,0,0,,WHEN WE ANALYZED
Dialogue: 0,0:01:01.98,0:01:04.90,ReelSub,,0,0,0,,WHY HE FELL INTO THIS STATE,
Dialogue: 0,0:01:04.90,0:01:07.76,ReelSub,,0,0,0,,HIS SURROUNDING ENVIRONMENT
Dialogue: 0,0:01:07.76,0:01:10.36,ReelSub,,0,0,0,,HAD A MASSIVE NEGATIVE IMPACT.
Dialogue: 0,0:01:10.36,0:01:12.84,ReelSub,,0,0,0,,HE JOINED TO WORK HAPPILY,
Dialogue: 0,0:01:12.84,0:01:14.92,ReelSub,,0,0,0,,WAS HIGHLY KNOWLEDGEABLE,
Dialogue: 0,0:01:14.92,0:01:17.22,ReelSub,,0,0,0,,AND MINGLED WELL WITH EVERYONE.
Dialogue: 0,0:01:17.22,0:01:20.26,ReelSub,,0,0,0,,YET THEIR INTENTION TO PUSH HIM OUT
Dialogue: 0,0:01:20.26,0:01:23.30,ReelSub,,0,0,0,,CREATED A DEVASTATING IMPACT
Dialogue: 0,0:01:23.30,0:01:26.88,ReelSub,,0,0,0,,ON HIS ENTIRE LIFE.
Dialogue: 1,0:00:02.10,0:00:04.12,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}TOXIC
Dialogue: 1,0:00:33.28,0:00:35.48,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}SALARY
Dialogue: 1,0:00:52.88,0:00:55.08,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}DEPRESSION
Dialogue: 1,0:00:38.38,0:00:40.58,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}EARNED TWICE
Dialogue: 1,0:00:40.82,0:00:43.02,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}THIS MADE
Dialogue: 1,0:01:20.26,0:01:22.46,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}CREATED DEVASTATING
