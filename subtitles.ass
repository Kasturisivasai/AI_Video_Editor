Dialogue: 0,0:00:00.00,0:00:01.80,ReelSub,,0,0,0,,LET'S SEE THE QUALITIES
Dialogue: 0,0:00:01.80,0:00:03.80,ReelSub,,0,0,0,,OF A BEST EMPLOYEE.
Dialogue: 0,0:00:03.80,0:00:05.80,ReelSub,,0,0,0,,I AM DR. HYMA PRASAD,
Dialogue: 0,0:00:05.80,0:00:07.50,ReelSub,,0,0,0,,WHO IS A PSYCHOLOGIST.
Dialogue: 0,0:00:07.50,0:00:09.50,ReelSub,,0,0,0,,HOW SHOULD AN EMPLOYEE
Dialogue: 0,0:00:09.50,0:00:11.50,ReelSub,,0,0,0,,BEHAVE AT THEIR WORKPLACE?
Dialogue: 0,0:00:11.50,0:00:14.50,ReelSub,,0,0,0,,THEY NEED GOOD COMMUNICATION
Dialogue: 0,0:00:14.50,0:00:17.00,ReelSub,,0,0,0,,AND A PROPER WAY
Dialogue: 0,0:00:17.00,0:00:20.00,ReelSub,,0,0,0,,OF SPEAKING WITH OTHERS.
Dialogue: 0,0:00:20.00,0:00:22.80,ReelSub,,0,0,0,,THEY SHOULD HAVE GRATITUDE
Dialogue: 0,0:00:22.80,0:00:24.80,ReelSub,,0,0,0,,TOWARDS THEIR JOB.
Dialogue: 0,0:00:24.80,0:00:26.80,ReelSub,,0,0,0,,NOWADAYS, MANY PEOPLE
Dialogue: 0,0:00:26.80,0:00:29.50,ReelSub,,0,0,0,,COMPLAIN AFTER GETTING EMPLOYED.
Dialogue: 0,0:00:29.50,0:00:32.00,ReelSub,,0,0,0,,THEY FEEL HIGHLY DISSATISFIED.
Dialogue: 0,0:00:32.00,0:00:34.50,ReelSub,,0,0,0,,SO, THEY SHOULD BE GRATEFUL
Dialogue: 0,0:00:34.50,0:00:36.80,ReelSub,,0,0,0,,FOR HAVING A JOB
Dialogue: 0,0:00:36.80,0:00:39.50,ReelSub,,0,0,0,,AND TREAT IT AS DIVINE.
Dialogue: 0,0:00:39.50,0:00:41.50,ReelSub,,0,0,0,,THEY MUST SHOW GRATITUDE.
Dialogue: 0,0:00:41.50,0:00:44.20,ReelSub,,0,0,0,,ALONG WITH DEDICATION,
Dialogue: 0,0:00:44.20,0:00:46.50,ReelSub,,0,0,0,,THEY SHOULD WORK
Dialogue: 0,0:00:46.50,0:00:49.50,ReelSub,,0,0,0,,WITHOUT DELAYING ANY TASKS.
Dialogue: 0,0:00:49.50,0:00:51.50,ReelSub,,0,0,0,,THEY MUST PROVE
Dialogue: 0,0:00:51.50,0:00:54.20,ReelSub,,0,0,0,,THEIR INNER CAPABILITIES
Dialogue: 0,0:00:54.20,0:00:57.00,ReelSub,,0,0,0,,AND LEARN NEW SKILLS.
Dialogue: 0,0:00:57.00,0:01:00.00,ReelSub,,0,0,0,,THEY SHOULD PRACTICE PATIENCE
Dialogue: 0,0:01:00.00,0:01:03.00,ReelSub,,0,0,0,,EVEN IF INSTRUCTORS GET
Dialogue: 0,0:01:03.00,0:01:06.00,ReelSub,,0,0,0,,ANNOYED OR SCOLD THEM.
Dialogue: 0,0:01:06.00,0:01:09.00,ReelSub,,0,0,0,,THEY MUST REMAIN CALM
Dialogue: 0,0:01:09.00,0:01:12.50,ReelSub,,0,0,0,,AND FOCUS ON LEARNING.
Dialogue: 0,0:01:12.50,0:01:15.50,ReelSub,,0,0,0,,DEVELOPING THESE SKILLS
Dialogue: 0,0:01:15.50,0:01:18.50,ReelSub,,0,0,0,,BOOSTS INTEREST IN WORK.
Dialogue: 0,0:01:18.50,0:01:21.00,ReelSub,,0,0,0,,ANY EMPLOYEE WITH THESE
Dialogue: 0,0:01:21.00,0:01:23.20,ReelSub,,0,0,0,,QUALITIES WILL LOVE
Dialogue: 0,0:01:23.20,0:01:25.80,ReelSub,,0,0,0,,THEIR JOB NATURALLY.
Dialogue: 0,0:01:25.80,0:01:28.20,ReelSub,,0,0,0,,YOU MUST TAKE UP
Dialogue: 0,0:01:28.20,0:01:31.50,ReelSub,,0,0,0,,EVERY TASK AS A CHALLENGE.
Dialogue: 0,0:01:31.50,0:01:34.50,ReelSub,,0,0,0,,BY DOING THIS,
Dialogue: 0,0:01:34.50,0:01:37.80,ReelSub,,0,0,0,,YOU CAN EASILY REACH
Dialogue: 0,0:01:37.80,0:01:44.00,ReelSub,,0,0,0,,YOUR DESIRED HIGH POSITION.
Dialogue: 1,0:00:00.45,0:00:02.25,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}BEST EMPLOYEE
Dialogue: 1,0:00:10.00,0:00:11.80,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}COMMUNICATION
Dialogue: 1,0:00:17.60,0:00:19.40,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}GRATITUDE
Dialogue: 1,0:00:40.00,0:00:41.80,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}DEDICATION
Dialogue: 1,0:00:54.80,0:00:56.60,PunchCallout,,0,0,0,,{\c&H00FFFFFF&}PATIENCE
